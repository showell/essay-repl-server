-- **ONE ROC MODULE, FOR REVIEW ON THE ESSAY SURFACE**: the module in
-- chunks of about 25 lines, each a code block followed by one paragraph
-- naming its lines and what it defines, which carries the surface's note
-- button: Steve replies under any chunk. Run it from the module's repo;
-- it writes `notes/review-<repo>-<Module>.md`, commits and pushes it, and
-- prints the URL. `dry=1` prints instead each chunk's lines, size, names
-- and first and last line, and writes nothing.
--
--   cd ~/showell_repos/gopher-roc && shale ../essay-repl-server/tools/roc_review.shale file=app/Transcript.roc
--   cd ~/showell_repos/gopher-roc && shale ../essay-repl-server/tools/roc_review.shale file=app/Transcript.roc dry=1
--
-- **CHUNKS END AT THE MODULE'S OWN BOUNDARIES**, read from Roc's parser
-- (`roc_tree`), in two passes:
--   1. **THE DEFINITIONS**: each top-level statement is a unit (a
--      definition, an `expect`, an import, the app header), and so is each
--      associated definition in a type's body (`X :: T.{ ... }`); the
--      body's opening line goes with its first, its closing `}` with its
--      last, and a header of three lines or more is a unit of its own. An
--      annotation and its definition are one unit, and the comments (`##`
--      or `#`) above a unit are its. A unit over `BIG` lines is split, and
--      each part again while over it, at the cleanest line that leaves
--      both parts at least `LEAST` lines: a nested associated definition
--      first, then a statement of a block or a branch of a `match`, then an
--      item of a list, record, call or pattern (each the shallowest in the
--      tree first, then the most even split), then any line after a blank
--      one, and only with none of those a cut in the middle.
--   2. **THE CHUNKS**: the units and parts, in order, are grouped so the
--      sum of each chunk's `(lines - TARGET)² / SPREAD` and of its breaks'
--      costs is least. A break costs three `STEP`s, less one where a blank
--      line separates the two, one where they differ in kind (import,
--      definition, the type's body, expect) and one where a comment opens
--      the second (a doc comment, a test group's heading): so a run of
--      small definitions or expects is one chunk, cut where a heading
--      starts a group, a 40-line function stays whole, and a 12-line one
--      stands alone between big ones. No chunk of several units passes
--      `BIG` lines, and a split unit's parts join nothing else.
--
-- **A REVIEW WITH REPLIES IS NEVER OVERWRITTEN**: the surface keeps
-- replies by paragraph number (data/comments/notes/<note>.comments.json),
-- so a rewritten note would hang them under the wrong chunks. Such a run
-- stops, naming the file; move or remove it first.

const FILE = arg("file", "")
if FILE == "" then fail("roc_review: file=<path to a .roc module>, run from its repo") end
if not ends_with(FILE, ".roc") then fail("roc_review: " .. FILE .. " is not a .roc file") end
const DRY = arg("dry", "") == "1"
const TEXT = read(FILE)
const LS = lines(TEXT)
const ESSAYS = real("repos:essay-repl-server")
const TARGET = 25
const BIG = 45
const LEAST = 12
const STEP = 25
const SPREAD = 3

-- The parents whose children are a sequence, and how clean a break
-- between two of them is (0 the cleanest).
const RANKS = {associated = 0, statements = 1, branches = 1, ["e-list"] = 2, ["e-record"] = 2, args = 2, ["p-list"] = 2, ["p-record"] = 2, ["p-tuple"] = 2, ["e-tuple"] = 2, ["ty-record"] = 2, tags = 2, ["e-multiline-string"] = 2}

function blank(l)
  return trim(l) == ""
end

-- The first line from `i` on that is not blank (past the end if none).
function next_text(ls, i)
  local at = i
  while at <= #ls and blank(ls[at]) do at = at + 1 end
  return at
end

-- ── the tree ─────────────────────────────────────────────────────────────

-- The file's nodes, each with `from`/`to` lines and `depth`: a node the
-- parser gives no span (`statements`, `branches`, `e-match`) spans its
-- children.
function tree(path)
  local got = roc_tree({path})
  local f = got[1]
  if f.err ~= "" then fail("roc_review: " .. path .. " does not parse: " .. f.err) end
  local ns = {}
  for n in f.nodes do
    push(ns, {kind = n.kind, name = get(n, "name", ""), raw = get(n, "raw", ""), from = n.line, to = n.end_line, kids = n.kids, parent = n.parent, depth = 0})
  end
  for i = 2, #ns do ns[i].depth = ns[ns[i].parent].depth + 1 end
  local k = #ns
  while k >= 2 do
    local n = ns[k]
    local p = ns[n.parent]
    if n.from > 0 then
      if p.from == 0 or n.from < p.from then p.from = n.from end
      if n.to > p.to then p.to = n.to end
    end
    k = k - 1
  end
  return ns
end

-- A definition's name: an annotation's, a `name = ...`'s, a type's.
function name_of(ns, i)
  local n = ns[i]
  if n.kind == "s-type-anno" then return n.name end
  if n.kind == "s-decl" and #n.kids > 0 and ns[n.kids[1]].kind == "p-ident" then return ns[n.kids[1]].raw end
  if n.kind == "s-type-decl" then
    for k in n.kids do
      if ns[k].kind == "header" then return ns[k].name end
    end
  end
  return ""
end

-- Whether node `k`, a definition, follows its own annotation `prev`.
function annotated(ns, prev, k)
  return prev > 0 and ns[prev].kind == "s-type-anno" and ns[k].kind == "s-decl" and name_of(ns, k) ~= "" and name_of(ns, prev) == name_of(ns, k)
end

function kind_of(n)
  if n.kind == "s-expect" then return "expect" end
  if n.kind == "s-import" then return "import" end
  if n.kind == "app" then return "header" end
  return "definition"
end

-- ── pass 1: the units ────────────────────────────────────────────────────

-- The statements a unit is made of, in order: `{nodes, kind}` each, an
-- annotation joined to its definition, a type's associated definitions
-- each their own (`kind` "body"), its header one too when it is long.
function statements(ns)
  local out = {}
  for top in ns[1].kids do
    local t = ns[top]
    if t.kind == "app" then push(out, {nodes = {top}, kind = "header", from = t.from, to = t.to}) end
    if t.kind == "statements" then
      local prev = 0
      for k in t.kids do
        local n = ns[k]
        local assoc = 0
        if n.kind == "s-type-decl" then
          for c in n.kids do
            if ns[c].kind == "associated" and #ns[c].kids > 0 then assoc = c end
          end
        end
        if annotated(ns, prev, k) then
          local u = out[#out]
          push(u.nodes, k)
          u.to = n.to
        elseif assoc > 0 then
          local first = ns[ns[assoc].kids[1]].from
          -- The header's lines: the type's own to the body's first
          -- comment, or its first definition.
          local head_to = first - 1
          local i = n.from + 1
          while i < first do
            if starts_with(trim(LS[i]), "#") then
              head_to = i - 1
              break
            end
            i = i + 1
          end
          while head_to > n.from and blank(LS[head_to]) do head_to = head_to - 1 end
          -- A short header (`X :: T.{`) goes with the first definition,
          -- the type's name with it.
          local header = {k}
          if head_to - n.from + 1 >= 3 then
            push(out, {nodes = {k}, kind = "body", from = n.from, to = head_to})
            header = {}
          end
          local aprev = 0
          for c in ns[assoc].kids do
            if annotated(ns, aprev, c) then
              local u = out[#out]
              push(u.nodes, c)
              u.to = ns[c].to
            else
              push(header, c)
              push(out, {nodes = header, kind = "body", from = ns[c].from, to = ns[c].to})
              header = {}
            end
            aprev = c
          end
          out[#out].to = n.to
        else
          push(out, {nodes = {k}, kind = kind_of(n), from = n.from, to = n.to})
        end
        prev = k
      end
    end
  end
  -- Each unit from the first line with text after the one before it: its
  -- comments, and a type body's opening line, are its.
  local after = 0
  for u in out do
    u.from = next_text(LS, after + 1)
    after = u.to
  end
  out[#out].to = #LS
  return out
end

-- **EVERY PLACE A UNIT MAY BE SPLIT**, by line: `{rank, depth}`, the
-- cleanest of the nodes that start there. A node starts a place when its
-- parent is a sequence (`RANKS`) and it begins a line after its previous
-- sibling ends (or, the first, after its parent's own first line); the
-- place is the first line with text after that, so a comment above it
-- goes with it. A definition after its own annotation is no place.
function places(ns, units)
  local whole = {}
  for u in units do
    for k in u.nodes do whole["" .. k] = true end
  end
  local out = {}
  for i = 2, #ns do
    local n = ns[i]
    local p = ns[n.parent]
    local key = p.kind
    if key == "statements" and n.parent > 0 and p.parent == 1 then key = "" end
    if has_key(RANKS, key) and n.from > 0 and not has_key(whole, "" .. i) then
      local prev = 0
      for k in p.kids do
        if k == i then break end
        prev = k
      end
      local after = ns[p.parent].from
      if prev > 0 then after = ns[prev].to end
      if n.from > after and after > 0 and not annotated(ns, prev, i) then
        local at = next_text(LS, after + 1)
        local cand = {rank = RANKS[key], depth = n.depth}
        local was = get(out, "" .. at, nil)
        if was == nil or cand.rank < was.rank or (cand.rank == was.rank and cand.depth < was.depth) then out["" .. at] = cand end
      end
    end
  end
  -- Any line after a blank one, the last resort before a cut.
  for i = 2, #LS do
    if blank(LS[i - 1]) and not blank(LS[i]) and not has_key(out, "" .. i) then out["" .. i] = {rank = 3, depth = 0} end
  end
  return out
end

-- The lines `from` to `to` split while over `BIG`, at the cleanest place
-- (`places`) leaving both parts `LEAST` lines: `{from, to}` each, onto `out`.
function split_unit(at, from, to, out)
  if to - from + 1 <= BIG then
    push(out, {from = from, to = to})
    return nil
  end
  local best = 0
  local best_c = nil
  local best_odd = 0
  for i = from + LEAST, to - LEAST + 1 do
    local c = get(at, "" .. i, nil)
    if c ~= nil then
      local odd = abs((i - from) - (to - i + 1))
      local better = best_c == nil or c.rank < best_c.rank or (c.rank == best_c.rank and c.depth < best_c.depth) or (c.rank == best_c.rank and c.depth == best_c.depth and odd < best_odd)
      if better then
        best = i
        best_c = c
        best_odd = odd
      end
    end
  end
  if best == 0 then best = from + (to - from + 1) // 2 end
  split_unit(at, from, best - 1, out)
  split_unit(at, best, to, out)
  return nil
end

-- The pieces pass 2 groups: each unit, or each part of a split one, with
-- its unit's index (`unit`), names and kind, and `part` of `parts`.
function pieces(ns, units)
  local at = places(ns, units)
  local out = {}
  for ui = 1, #units do
    local u = units[ui]
    local parts = {}
    split_unit(at, u.from, u.to, parts)
    for pi = 1, #parts do
      -- A split definition's name says its part; a type's header that
      -- came with it (`X :: T.{`) is named in the first part only.
      local names = {}
      for k in u.nodes do
        local nm = name_of(ns, k)
        local header = ns[k].kind == "s-type-decl" and #u.nodes > 1
        if nm ~= "" and #parts > 1 and not header then nm = nm .. "` (part " .. pi .. " of " .. #parts .. ")" else nm = nm .. "`" end
        if nm ~= "`" and (pi == 1 or not header) and not contains(join(names, " "), "`" .. nm) then push(names, "`" .. nm) end
      end
      push(out, {from = parts[pi].from, to = parts[pi].to, unit = ui, kind = u.kind, names = names, part = pi, parts = #parts, expect = u.kind == "expect"})
    end
  end
  return out
end

-- ── pass 2: the chunks ───────────────────────────────────────────────────

-- The cost of a break between pieces `a` and the next, `b`.
function break_cost(a, b)
  local c = 3 * STEP
  if b.from > a.to + 1 and blank(LS[b.from - 1]) then c = c - STEP end
  if a.kind ~= b.kind then c = c - STEP end
  if starts_with(trim(LS[b.from]), "#") then c = c - STEP end
  return max(c, 0)
end

-- The pieces grouped into chunks, `{from, to, first, last}` each (the
-- pieces' indexes), at the least cost.
function chunks(ps)
  local n = #ps
  local best = {0}
  local back = {0}
  for j = 1, n do
    local b = -1
    local from_i = 0
    local i = j
    while i >= 1 do
      local size = ps[j].to - ps[i].from + 1
      if i < j and size > BIG then break end
      if i < j and (ps[i].parts > 1 or ps[i + 1].parts > 1) and ps[i].unit ~= ps[i + 1].unit then break end
      local c = best[i] + (size - TARGET) * (size - TARGET) // SPREAD
      if i > 1 then c = c + break_cost(ps[i - 1], ps[i]) end
      if b < 0 or c < b then
        b = c
        from_i = i
      end
      i = i - 1
    end
    push(best, b)
    push(back, from_i)
  end
  local out = {}
  local j = n
  while j >= 1 do
    local i = back[j + 1]
    push(out, {from = ps[i].from, to = ps[j].to, first = i, last = j})
    j = i - 1
  end
  reverse(out)
  return out
end

-- A chunk's lines with its blank edges dropped: `{from, to}`.
function trimmed(c)
  local from = c.from
  local to = c.to
  while from < to and blank(LS[from]) do from = from + 1 end
  while to > from and blank(LS[to]) do to = to - 1 end
  return {from = from, to = to}
end

-- What a chunk defines, for its paragraph: its definitions' names (a
-- split one's part, `of 2`), and its count of expects.
function summary(ps, c)
  local names = {}
  local expects = 0
  for k = c.first, c.last do
    local p = ps[k]
    if p.expect and p.part == 1 then expects = expects + 1 end
    for nm in p.names do
      if not contains(join(names, " "), nm) then push(names, nm) end
    end
  end
  local said = {}
  if #names > 0 then push(said, join(names, ", ")) end
  if expects == 1 then push(said, "1 expect") end
  if expects > 1 then push(said, expects .. " expects") end
  if #said == 0 then return "" end
  return ": " .. join(said, "; ")
end

const ns = tree(FILE)
const units = statements(ns)
const ps = pieces(ns, units)
const parts = chunks(ps)

if DRY then
  for k = 1, #parts do
    local c = trimmed(parts[k])
    print(pad(c.from .. "-" .. c.to, 9) .. pad("(" .. (c.to - c.from + 1) .. ")", 6) .. summary(ps, parts[k]))
    print("          | " .. trim_end(LS[c.from]))
    print("          | " .. trim_end(LS[c.to]))
  end
  print(#LS .. " lines, " .. #parts .. " chunks (dry run: nothing written)")
else
  local repo = basename(real("."))
  local module = strip_suffix(basename(FILE), ".roc")
  local slug = "review-" .. repo .. "-" .. module
  local note_path = ESSAYS .. "/notes/" .. slug .. ".md"
  local comments_path = "repos:essay-repl-server/data/comments/notes/" .. slug .. ".md.comments.json"
  if exists(comments_path) then fail("roc_review: " .. comments_path .. " holds replies to the last review of " .. FILE .. "; a new one would hang them under the wrong chunks. Move it aside first.") end

  local head = must(run({"git", "log", "-1", "--format=%h %s", "--", FILE}, {timeout_ms = 10000, whole = 10000, want = "git: the module's last commit"})).out
  local dirty = trim(must(run({"git", "status", "--short", "--", FILE}, {timeout_ms = 10000, whole = 10000, want = "git: whether the module has changes"})).out) ~= ""

  local fence = "```"
  if contains(TEXT, "```") then fence = "~~~~" end
  local note = "# Review: " .. repo .. " `" .. FILE .. "`\n\n"
    .. #LS .. " lines in " .. #parts .. " chunks, as of commit " .. trim(head) .. (dirty and ", with uncommitted changes" or "") .. ". Reply under any chunk; this paragraph is for the module as a whole.\n\n"
  for k = 1, #parts do
    local c = trimmed(parts[k])
    note = note .. fence .. "roc\n" .. join(slice(LS, c.from, c.to), "\n") .. "\n" .. fence .. "\n\n"
      .. "**Lines " .. c.from .. "–" .. c.to .. "**" .. summary(ps, parts[k]) .. "\n\n"
  end

  must(run({"tee", note_path}, {stdin = note, timeout_ms = 5000, whole = 10000000, want = "write: the note"}))
  must(run({"git", "-C", ESSAYS, "add", "notes/" .. slug .. ".md"}, {timeout_ms = 10000, whole = 10000, want = "git: add the note"}))
  local staged = run({"git", "-C", ESSAYS, "diff", "--cached", "--quiet"}, {timeout_ms = 10000, whole = 10000})
  if staged.code ~= 0 then
    must(run({"git", "-C", ESSAYS, "commit", "-q", "-m", "notes/" .. slug .. ": " .. FILE .. " for review"}, {timeout_ms = 10000, whole = 10000, want = "git: commit the note"}))
    must(run({"git", "-C", ESSAYS, "push", "-q"}, {timeout_ms = 60000, whole = 10000, want = "git: push the note"}))
  end
  print(#parts .. " chunks: http://143.244.172.148:9100/notes/" .. slug .. ".md")
end
